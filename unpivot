SELECT *
 FROM (
		SELECT
			   AC.MATRICULA,
			   AC.CODIGO,
			   REPLACE(COALESCE(CAST(AC.MEDIA1 AS VARCHAR(6)),'-'),'.',',') AS [1], 
			   REPLACE(COALESCE(CAST(AC.MEDIA2 AS VARCHAR(6)),'-'),'.',',') AS [2],
			   REPLACE(COALESCE(CAST(AC.MEDIA3 AS VARCHAR(6)),'-'),'.',',') AS [3],
			   REPLACE(COALESCE(CAST(AC.MEDIA4 AS VARCHAR(6)),'-'),'.',',') AS [4]
		  FROM ac AC WITH(NOLOCK)
		 WHERE AC.MATRICULA = 3416) AS TAB1
 UNPIVOT(NOTA
		  FOR ETAPA IN([1],[2],[3],[4])
	     ) AS TAB2
