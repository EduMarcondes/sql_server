SELECT [1],[2],[3],[4],[5]
  FROM (
		SELECT 
			   A.ORDEM AS LINHA,

			   /* SOMA TODOS OS MINUTOS E CONVERTE PARA HORAS MINUTOS */
			   CAST(FLOOR(A.MINUTOS_TOTAIS / 60) AS VARCHAR(10)) + ':' + CAST(A.MINUTOS_TOTAIS % 60 AS VARCHAR(2)) AS CH
		  FROM (
				SELECT 
						SE.ORDEM,
					   /* CONVERTE TODA A CH RELOGIO PARA MINTOS */
					   SUM(
						   (SUBSTRING(DHA.CARGA_HORARIA,1,LEN(DHA.CARGA_HORARIA) - 3) * 60) +
						   (SUBSTRING(DHA.CARGA_HORARIA,LEN(DHA.CARGA_HORARIA) - 1,LEN(DHA.CARGA_HORARIA)))
					   )AS MINUTOS_TOTAIS	


				  FROM hist H WITH(NOLOCK)
				 INNER JOIN disha DHA WITH(NOLOCK)
					ON DHA.HISTORICO = H.CODIGO
				 INNER JOIN ser SE WITH(NOLOCK)
					ON SE.CODIGO = H.SERIE
				 WHERE H.CURSO = 3--:COD_CURSO
					AND H.FISICA = 2601--:COD_FISICA
				 GROUP BY SE.ORDEM
				 ) A
		 ) DISC
		 PIVOT(MAX(DISC.CH)
				FOR DISC.LINHA IN ([1],[2],[3],[4],[5])
	           ) AS ORDEM
