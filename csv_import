EXECUTE SP_CONFIGURE 'SHOW ADVANCED OPTIONS', 1;  
GO  

RECONFIGURE;  
GO  

EXECUTE SP_CONFIGURE 'XP_CMDSHELL', 1;  
GO  

RECONFIGURE;  
GO 

/* O CAOMANDO ABAIXO LISTA O CONTEUDO DE UMA PASTA CONTENDO TODOS OS CVS QUE PODERÃO SER USADO PARA GERAR O SCRIPT DE INSERT DE TABELA CSV EM MASSA.
   IMPORTANTE: A PASTA A SER LIDA NÃO PODE ESTAR DENTRO DE OUTRAS PASTAS COM CAMINHO MUITO EXTENSO E NEM COM ESPAÇOS */
DECLARE @CAMINHO_PASTA TABLE(CAMINHO VARCHAR(MAX))

EXEC XP_CMDSHELL 'DIR C:\PHIL /S /B /A-D'

--select * from @CAMINHO_PASTA

SELECT *
  FROM (
		SELECT 
				'BULK INSERT '+ REPLACE(REPLACE((SELECT CAMINHO FROM @CAMINHO_PASTA X WHERE X.CAMINHO = C.CAMINHO),'C:\PHIL\',''),'.CSV','')  +'
				FROM '''+ C.CAMINHO +'''
				WITH (
				FIELDTERMINATOR = '','',
				CODEPAGE = ' + '65001)' AS CAMINHO
				--ROWS_PER_BATCH = 1000 
		  FROM @CAMINHO_PASTA C
       )A
 WHERE A.CAMINHO IS NOT NULL
