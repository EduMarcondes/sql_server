SELECT 
       t.name
      ,c.name
      ,(select count(*) from (select t.name) a) as TemDado
      ,'update sophia.' + t.name + ' set ' + c.name + ' = 27 where ' + c.name + ' in(1,2);'
FROM 
    sys.foreign_keys fk
    INNER JOIN sys.tables t ON fk.parent_object_id = t.object_id
    INNER JOIN sys.foreign_key_columns fkc ON fk.object_id = fkc.constraint_object_id
    INNER JOIN sys.columns c ON fkc.parent_column_id = c.column_id AND fkc.parent_object_id = c.object_id
    INNER JOIN sys.tables ref ON fk.referenced_object_id = ref.object_id
WHERE 
    ref.name = 'serie' AND ref.schema_id = SCHEMA_ID('sophia')
