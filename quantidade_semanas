		(SELECT COUNT(DISTINCT DATEPART(WEEK, TAB.DATA ))
			FROM (SELECT DISTINCT COALESCE(CTURMA.DATA,CALEND.DATA) AS DATA
					FROM 
						(SELECT CALEND_DIAS.DATA
						FROM cd WITH(NOLOCK)
						WHERE CALEND_DIAS.DIA_LETIVO = 1 
							AND YEAR(CALEND_DIAS.DATA) = YEAR(T.INICIO)) AS CALEND
					LEFT JOIN cdt CTURMA WITH(NOLOCK)
					ON CTURMA.DATA = CALEND.DATA
					AND CTURMA.TURMA = T.CODIGO) TAB)
